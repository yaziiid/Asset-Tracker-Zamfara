{
  "name": "save80-stove-tracker",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-config.mjs && vite build",
    "build:check": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/domain.test.mjs tests/geocode.test.mjs tests/verification.test.mjs",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --project demo-zamfara --only firestore 'node --test tests/rules.test.mjs'",
    "import:records": "node scripts/import-records.mjs"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "jose": "^6.2.13",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "@opentelemetry/core": "^2.12.0",
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
