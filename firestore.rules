rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // members/UID: {role}. records/ID: shared project register with the validated fields below.
    // User authentication profiles and credentials are not stored in this database.
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function member() {
      return verified() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    function role() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role;
    }
    function admin() { return member() && role() == 'admin'; }
    function writer() { return member() && role() in ['admin', 'editor']; }
    function text(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }
    function validRecord(d) {
      return d.keys().hasAll(['name', 'address', 'phone', 'project', 'state', 'latitude', 'longitude', 'assetCount', 'date', 'createdAt', 'createdBy'])
        && d.keys().hasOnly(['name', 'address', 'phone', 'project', 'state', 'latitude', 'longitude', 'assetCount', 'date', 'createdAt', 'createdBy'])
        && text(d.name, 2, 120) && text(d.address, 5, 500)
        && text(d.phone, 0, 30) && text(d.project, 1, 120) && text(d.state, 2, 80)
        && d.latitude is number && d.latitude >= -90 && d.latitude <= 90
        && d.longitude is number && d.longitude >= -180 && d.longitude <= 180
        && d.assetCount is int && d.assetCount == 1
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.createdAt == request.time && d.createdBy == request.auth.uid;
    }
    function validMember(d) {
      return d.keys().hasAll(['role']) && d.keys().hasOnly(['role'])
        && d.role in ['admin', 'editor', 'viewer'];
    }
    match /members/{uid} {
      allow get: if verified() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create, update: if admin() && request.auth.uid != uid
        && validMember(request.resource.data);
      // An admin cannot remove or demote their own access accidentally.
      allow delete: if admin() && request.auth.uid != uid;
    }
    match /records/{id} {
      allow read: if member() && role() in ['admin', 'editor', 'viewer'];
      // One immutable record per exact Product ID; hashing also supports IDs containing slashes.
      allow create: if writer() && validRecord(request.resource.data)
        && id == 'stove-' + hashing.sha256(request.resource.data.project.toUtf8()).toHexString().lower();
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
