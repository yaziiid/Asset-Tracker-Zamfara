# Public Firebase web app configuration (not service-account credentials).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Public browser key: restrict to this site and the Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=
# Netlify Functions environment only; never prefix this with VITE_.
GOOGLE_GEOCODING_API_KEY=
