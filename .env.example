# Environment Configuration for National Infrastructure Monitoring System
# Copy this file to .env and fill in your actual values

# Database Configuration
# Use DATABASE_URL for JawsDB MySQL or other database providers (preferred)
DATABASE_URL=mysql://username:password@hostname:port/database_name

# Alternative individual database variables (fallback)
DB_HOSTNAME=localhost
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_database_name

# Redis Configuration
# Use REDISCLOUD_URL for Redis Cloud add-on (preferred)
REDISCLOUD_URL=redis://:password@hostname:port/0

# Alternative Redis variables (fallback)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost

# Application Configuration
SECRET_KEY=your-very-secret-flask-key-here
GEOCODE_API=your-google-maps-geocoding-api-key
MAPBOX_API=your-mapbox-api-key

# Mail Configuration (for password reset features)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password

# Heroku Specific (for deployment)
WSGI_MODULE=main:app